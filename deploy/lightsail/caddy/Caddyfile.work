# 작업용 서버(내 AWS Lightsail 54.252.22.31) 전용 — 이 서버에는 paperclf 하나뿐이고 delivery-eta 가 없다
#   54-252-22-31.sslip.io → paperclf(127.0.0.1:8080), HTTPS 인증서는 Caddy 가 자동 발급 (Let's Encrypt)
#   sslip.io 는 이름 속 숫자를 그대로 IP 로 돌려주는 공개 DNS — 도메인을 사지 않고 인증서를 받으려고 쓴다
# 최종 서버(nlpwizard.eta.pyhub.kr, eta 와 공존)는 Caddyfile 을 쓴다. 이 파일은 /srv/caddy/Caddyfile 로 복사해 쓴다
#
# `:80` 모두 받기 블록은 두지 않는다:
#   - 위 이름의 80 번 요청은 Caddy 가 알아서 HTTPS 로 돌려보낸다 (자동 리디렉트, 인증서 발급 확인용 80 도 Caddy 가 처리)
#   - IP 로 직접 오는 평문 HTTP 를 앱에 넘기면 HTTPS 를 건너뛰는 길이 생긴다
#   - 배포 확인(server.sh health)은 Caddy 를 거치지 않고 127.0.0.1:8080 을 직접 본다 — 80 이 없어도 CI 는 그대로 돈다
#   - eta 가 없으니 이름 없는 요청을 넘길 곳도 없다
{
	admin off
}

54-252-22-31.sslip.io {
	encode zstd gzip
	# 보안 헤더 — HTTPS 만 쓰게(HSTS 1년), MIME 추측 막기, 참조 정보 줄이기, 뒤 서버 이름 숨기기
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	reverse_proxy 127.0.0.1:8080 {
		header_down -Server
	}
}
